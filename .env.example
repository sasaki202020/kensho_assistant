# Keep the encrypted profile outside this Git repository.
# Replace <WindowsUser> locally; never commit the resulting .env file.
KENSHO_PROFILE_PATH=C:\Users\<WindowsUser>\AppData\Local\kensho_assistant\profile.enc

# The web application remains loopback-only.
KENSHO_WEB_HOST=127.0.0.1
KENSHO_WEB_PORT=8787
